const { SlashCommandBuilder, EmbedBuilder } = require('discord.js');

module.exports = {
  data: new SlashCommandBuilder()
    .setName('help-commande')
    .setDescription('Aide détaillée sur une commande du bot Prairie')
    .addStringOption(option =>
      option.setName('commande')
        .setDescription('La commande sur laquelle tu veux de l\'aide')
        .setRequired(true)
        .addChoices(
          { name: '/lier', value: 'lier' },
          { name: '/settings', value: 'settings' },
          { name: '/profil', value: 'profil' },
          { name: '/carte-profil', value: 'carte-profil' },
          { name: '/classement', value: 'classement' },
          { name: '/rusheurs', value: 'rusheurs' },
          { name: '/clubs', value: 'clubs' },
          { name: '/absence', value: 'absence' },
          { name: '/absence-annuler', value: 'absence-annuler' },
        )
    ),

  async execute(interaction) {
    await interaction.deferReply;

    const commande = interaction.options.getString('commande');
    const embed = buildHelpEmbed(commande);

    if (!embed) {
      return interaction.editReply({ content: '❌ Commande inconnue.' });
    }

    await interaction.editReply({ embeds: [embed] });
  }
};

